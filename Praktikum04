+Mengecek data sebelumnya
SELECT * FROM fasilitas_publik;
SELECT * FROM jalan;
SELECT * FROM wilayah;

+Mengukur jarak
SELECT 
    a.nama AS fasilitas_asal, 
    b.nama AS fasilitas_tujuan,
    ROUND(ST_Distance(a.geom::geography, b.geom::geography)::numeric, 2) AS jarak_meter
FROM fasilitas_publik a, fasilitas_publik b
WHERE a.id < b.id
LIMIT 3;

+Mendeteksi apakah memotong jalan atau melewati batas suatu wilayah
SELECT 
    w.nama AS nama_wilayah, 
    j.nama AS nama_jalan
FROM jalan j
JOIN wilayah w ON ST_Intersects(j.geom, w.geom);

+Memetakan fasilitas publik sesuai dengan wilayah
SELECT 
    w.nama AS nama_wilayah, 
    f.nama AS nama_fasilitas, 
    f.jenis
FROM wilayah w
JOIN fasilitas_publik f ON ST_Contains(w.geom, f.geom);

+Mencari lokasi terdekat dari kost
SELECT 
    nama, 
    jenis,
    ROUND(ST_Distance(geom::geography, ST_GeomFromText('POINT(105.3048 -5.3613)', 4326)::geography)::numeric, 2) AS jarak_ke_rumah_m
FROM fasilitas_publik
ORDER BY geom <-> ST_GeomFromText('POINT(105.3048 -5.3613)', 4326)
LIMIT 3;

+Menghitung kepadatan sebaran di masing-masing wilayah
SELECT 
    w.nama AS nama_wilayah, 
    COUNT(f.id) AS jumlah_fasilitas,
    ROUND((ST_Area(w.geom::geography) / 1000000)::numeric, 2) AS luas_km2,
    ROUND((COUNT(f.id)::numeric / (ST_Area(w.geom::geography) / 1000000))::numeric, 2) AS rasio_kepadatan_per_km2
FROM wilayah w
LEFT JOIN fasilitas_publik f ON ST_Contains(w.geom, f.geom)
GROUP BY w.id, w.nama, w.geom
ORDER BY rasio_kepadatan_per_km2 DESC;
