+Ujicoba Transformasi Data (GCS ke PCS)
SELECT 
    nama,
    ST_AsText(geom) AS koordinat_wgs84_derajat,
    ST_AsText(ST_Transform(geom, 32748)) AS koordinat_utm48s_meter
FROM fasilitas_publik;

+Menghitung Jarak antar fasilitas
SELECT 
    a.nama AS asal, 
    b.nama AS tujuan,
    ST_Distance(ST_Transform(a.geom, 32748), ST_Transform(b.geom, 32748)) AS jarak_utm_meter
FROM fasilitas_publik a, fasilitas_publik b
WHERE a.id < b.id --Menghindari duplikasi jarak terbalik dan jarak ke diri sendiri
LIMIT 5;

+Menghitung luas wilayah UTM
SELECT 
    nama,
    ST_Area(ST_Transform(geom, 32748)) AS luas_meter_persegi,
    ST_Area(ST_Transform(geom, 32748)) / 10000 AS luas_hektar,
    ST_Area(geom::geography) AS luas_geography_m2
FROM wilayah;
