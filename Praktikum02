+Menguji Tabel Jalan
SELECT 
    id, 
    nama, 
    ST_AsText(geom) AS wkt_format, 
    ST_AsGeoJSON(geom) AS geojson_format, 
    ST_IsValid(geom) AS status_validasi 
FROM jalan;

